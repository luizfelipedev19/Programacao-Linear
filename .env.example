# --- Execução com Docker (docker compose up) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=projeto_linear
MYSQL_USER=linear
MYSQL_PASSWORD=linear
MYSQL_PORT=3306
BACKEND_PORT=3000
JWT_SECRET=troque-esta-chave-por-uma-chave-longa-e-aleatoria
# Mínimo de 32 caracteres. Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Origens (front-end) autorizadas pelo CORS, separadas por vírgula. Padrão: Vite.
CORS_ORIGIN=http://localhost:5173

# --- Execução sem Docker (npm run dev, com MySQL local) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=projeto_linear
# DB_USER=root
# DB_PASSWORD=qualquercoisa
# PORT=3000
# JWT_SECRET e CORS_ORIGIN também são necessários neste modo.

# --- Opcionais ---
# NODE_ENV=production        (desliga o Swagger, exceto com SWAGGER_ENABLED=true)
# TRUST_PROXY=true           (somente atrás de proxy reverso confiável)
# RATE_LIMIT_GLOBAL=300      (requisições por minuto por IP)
# RATE_LIMIT_LOGIN=10        (tentativas de login por minuto por IP)
# RATE_LIMIT_CADASTRO=10     (cadastros por hora por IP)
# RATE_LIMIT_EXECUTAR=30     (execuções do solver por minuto por IP)
